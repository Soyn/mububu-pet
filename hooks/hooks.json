{
  "description": "The muse-pet hooks module, and a version check for Claude Code builds too old to run it",
  "modules": [
    "./register.ts"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/check-version.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
